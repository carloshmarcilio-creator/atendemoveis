# ─────────────────────────────────────────
# AtendeMóveis — Variáveis de Ambiente
# Renomeie este arquivo para .env e preencha
# ─────────────────────────────────────────

# ── Z-API (WhatsApp) ──────────────────────
# Crie sua conta em: https://z-api.io
# Painel > Instâncias > sua instância > copie os 3 valores abaixo
ZAPI_INSTANCE=SUA_INSTANCIA_AQUI
ZAPI_TOKEN=SEU_TOKEN_AQUI
ZAPI_CLIENT_TOKEN=SEU_CLIENT_TOKEN_AQUI

# ── Anthropic Claude (IA) ─────────────────
# Crie sua chave em: https://console.anthropic.com
# Menu > API Keys > Create Key
ANTHROPIC_API_KEY=sk-ant-SUA_CHAVE_AQUI

# ── Servidor ──────────────────────────────
# Railway define PORT automaticamente — não altere
PORT=3000
